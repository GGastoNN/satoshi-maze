static func _document() -> Dictionary:
	var lang: String = Localization.current_language()
	var document: Dictionary = DOCUMENTS.get(lang, DOCUMENTS["en"])
	return document

static func privacy_title() -> String:
	return str(_document().get("privacy_title", "PRIVACY POLICY"))

static func privacy_intro() -> String:
	return str(_document().get("privacy_intro", ""))

static func privacy_sections() -> Array:
	var document: Dictionary = _document()
	var sections: Array = document.get("privacy_sections", [])
	return sections

static func terms_title() -> String:
	return str(_document().get("terms_title", "TERMS AND CONDITIONS"))

static func terms_intro() -> String:
	return str(_document().get("terms_intro", ""))

static func terms_sections() -> Array:
	var document: Dictionary = _document()
	var sections: Array = document.get("terms_sections", [])
	return sections
